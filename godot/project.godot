; Engine configuration file.
; Godot 4.3 or later.

config_version=5

[application]

config/name="OpenIC"
config/description="OpenIC: an unofficial, non-commercial fan port of the 1991 X68000 game 幻影都市 (Illusion City)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
Audio="*res://scripts/autoload/audio.gd"
GameText="*res://scripts/autoload/game_text.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=768
window/size/viewport_height=512
window/size/window_width_override=1536
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
